process {
    withName: DIANN_SEARCH {
        cpus = 1
        memory = '8 GB'
        time = '24h'
    }
}

profiles {
    conda {
        conda.enabled = true
        conda.cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${System.getenv('HOME')}/.conda/envs"
    }
}

workDir = System.getenv('NXF_WORK_DIR') ?: "${System.getenv('HOME')}/.cache/nextflow/work"
