# Copy to C:\MSConnect\.env, then edit for each worker.
# Paths below are Linux paths as seen inside the WSL2 distribution.
DJANGO_SECRET_KEY=processor-local-only
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MSCONNECT_PYTHON=/home/<wsl-user>/.venvs/msconnect/bin/python

MSCONNECT_API_BASE_URL=https://msconnect.<tailnet-name>.ts.net/api
MSCONNECT_AGENT_TOKEN=replace-with-unique-processor-token
MSCONNECT_AGENT_NAME=diann-windows-01
MSCONNECT_PROCESSOR_ENGINE=diann
MSCONNECT_PROCESSOR_ENGINE_VERSION=2.2.0
MSCONNECT_PROCESSOR_ENGINE_PROFILE=diann:2.2.0
PROCESSOR_POLL_INTERVAL_SECONDS=15

RAW_FILE_STORAGE_ROOT=/mnt/msconnect/raw
RESULTS_ROOT=/mnt/msconnect/results
PROCESSOR_SHARED_STORAGE_ROOT=/mnt/msconnect/shared
MSCONNECT_DIANN_NEXTFLOW_WORKFLOW=/mnt/msconnect/shared/nextflow/diann/main.nf
MSCONNECT_DIANN_VERSION_CATALOG=/mnt/msconnect/shared/nextflow/diann/versions.json
MSCONNECT_DIANN_VERSION=2.2.0
