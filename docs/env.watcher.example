DJANGO_SECRET_KEY=watcher-local-only
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

INCOMING_RAW_ROOT=/data/incoming
RAW_FILE_STORAGE_ROOT=/data/raw
RESULTS_ROOT=/data/results
PROCESSOR_SHARED_STORAGE_ROOT=/data/shared
MSCONNECT_ARCHIVE_ROOTS=/data/archive
MSCONNECT_BACKUP_ROOTS=/data/backup

INCOMING_RAW_HOST_PATH=/mnt/msconnect/incoming
RAW_STORAGE_HOST_PATH=/mnt/msconnect/raw
RESULTS_HOST_PATH=/mnt/msconnect/results
ARCHIVE_HOST_PATH=/mnt/msconnect/archive
BACKUP_HOST_PATH=/mnt/msconnect/backup

MSCONNECT_API_BASE_URL=http://msconnect-server:8000/api
MSCONNECT_API_DISCOVERY_HOSTS=web,server,django,msconnect
MSCONNECT_AGENT_TOKEN=replace-with-watcher-token
MSCONNECT_AGENT_NAME=uploader-watcher-1
WATCHER_INTERVAL_SECONDS=60
MSCONNECT_AGENT_HEALTH_DIR=/app/data/agent-health
MSCONNECT_IMAGE=msconnect:site
