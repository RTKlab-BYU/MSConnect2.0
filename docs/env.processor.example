DJANGO_SECRET_KEY=processor-local-only
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

RAW_FILE_STORAGE_ROOT=/data/raw
RESULTS_ROOT=/data/results
PROCESSOR_SHARED_STORAGE_ROOT=/data/shared
MSCONNECT_ARCHIVE_ROOTS=/data/archive
MSCONNECT_BACKUP_ROOTS=/data/backup

RAW_STORAGE_HOST_PATH=/mnt/msconnect/raw
RESULTS_HOST_PATH=/mnt/msconnect/results
ARCHIVE_HOST_PATH=/mnt/msconnect/archive
BACKUP_HOST_PATH=/mnt/msconnect/backup
PROCESSOR_SHARED_HOST_PATH=/mnt/msconnect/shared

MSCONNECT_API_BASE_URL=http://msconnect-server:8000/api
MSCONNECT_API_DISCOVERY_HOSTS=web,server,django,msconnect
MSCONNECT_AGENT_TOKEN=replace-with-processor-token
MSCONNECT_AGENT_NAME=diann-1
MSCONNECT_PROCESSOR_ENGINE=diann
MSCONNECT_PROCESSOR_ENGINE_VERSION=2.0
MSCONNECT_PROCESSOR_ENGINE_PROFILE=diann:2.0
MSCONNECT_DIANN_IMAGE=msconnect-processor-diann:2.0
DIANN_ENGINE_VERSION=2.0
DIANN_ENGINE_PROFILE=diann:2.0
# Point this at the site-approved Linux DIA-NN 2.0 ZIP. Do not use the Windows MSI for Linux containers.
DIANN_LINUX_URL=https://github.com/vdemichev/DiaNN/releases/download/2.0/DIA-NN-2.0-Academia-Linux.zip
MSCONNECT_PRTC_SKYLINE_PIPELINE_ID=
SKYLINE_BASE_IMAGE=proteowizard/pwiz-skyline-i-agree-to-the-vendor-licenses:skyline_26.1.0.057-c07debd
MSCONNECT_SKYLINE_IMAGE=msconnect-processor-skyline:26.1
SKYLINE_ENGINE_VERSION=26.1.0
SKYLINE_ENGINE_PROFILE=skyline:26.1.0
PROCESSOR_POLL_INTERVAL_SECONDS=15
MSCONNECT_AGENT_HEALTH_DIR=/app/data/agent-health
MSCONNECT_IMAGE=msconnect:site
MSCONNECT_RELEASE_VERSION=2026.09.0
# MSCONNECT_UPGRADE_HOOK=/opt/msconnect2/bin/apply-release
