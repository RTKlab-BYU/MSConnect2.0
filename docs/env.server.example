DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=msconnect.local,localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://msconnect.local,http://localhost:8080
DJANGO_TIME_ZONE=America/Denver
# The first web startup creates this account if the database has no superuser.
# Change these values before the initial deployment. They are never used to
# overwrite an existing account; after login, change the password in Django
# admin or with `python manage.py changepassword <username>`.
MSCONNECT_BOOTSTRAP_SUPERUSER_USERNAME=admin
MSCONNECT_BOOTSTRAP_SUPERUSER_EMAIL=admin@your-lab.example
MSCONNECT_BOOTSTRAP_SUPERUSER_PASSWORD=replace-with-a-long-initial-password
# The production Compose overlay requires Postgres. Keep SQLite only for local
# development and single-process demonstrations.
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=msconnect
DJANGO_DB_USER=msconnect
DJANGO_DB_PASSWORD=replace-with-a-long-database-secret
DJANGO_DB_HOST=postgres
DJANGO_DB_PORT=5432
POSTGRES_DATA_HOST_PATH=/srv/msconnect/postgres
MSCONNECT_DEFAULT_FACILITY_SLUG=proteomics-core
DIRECT_UPLOAD_STAGING_ROOT=/app/media/direct-uploads

MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
INCOMING_RAW_ROOT=/data/incoming
RAW_FILE_STORAGE_ROOT=/data/raw
RESULTS_ROOT=/data/results
PROCESSOR_SHARED_STORAGE_ROOT=/data/shared
MSCONNECT_ARCHIVE_ROOTS=/data/archive
MSCONNECT_BACKUP_ROOTS=/data/backup
MSCONNECT_STORAGE_WARN_PERCENT=80
MSCONNECT_STORAGE_BLOCK_PERCENT=95

INCOMING_RAW_HOST_PATH=/srv/msconnect/incoming
RAW_STORAGE_HOST_PATH=/srv/msconnect/raw
RESULTS_HOST_PATH=/srv/msconnect/results
ARCHIVE_HOST_PATH=/srv/msconnect/archive
BACKUP_HOST_PATH=/srv/msconnect/backup
PROCESSOR_SHARED_HOST_PATH=/srv/msconnect/shared
MSCONNECT_DATA_HOST_PATH=/srv/msconnect/data
MSCONNECT_MEDIA_HOST_PATH=/srv/msconnect/media
MSCONNECT_STATIC_HOST_PATH=/srv/msconnect/staticfiles
MSCONNECT_NGINX_PORT=80

MSCONNECT_WATCHER_TOKEN=replace-with-watcher-token
# Optional per-instrument direct-upload tokens. Comma-separated label=token pairs.
MSCONNECT_WATCHER_TOKENS=ms01=replace-with-ms01-token,ms02=replace-with-ms02-token
MSCONNECT_PROCESSOR_TOKEN=replace-with-processor-token
MSCONNECT_API_BASE_URL=http://web:8000/api
MSCONNECT_PRODUCTION=1
MSCONNECT_IMAGE=registry.example.org/msconnect/msconnect:2026.09.17
DEFAULT_FROM_EMAIL=msconnect@your-lab.example
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-lab.example
EMAIL_PORT=587
EMAIL_HOST_USER=msconnect@your-lab.example
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=1
MSCONNECT_EMAIL_FAIL_SILENT=0
MSCONNECT_NOTIFICATION_EMAILS=ops@your-lab.example
MSCONNECT_RELEASE_VERSION=2026.09.0
# Optional upgrade hook for agents that run directly on the host. Docker
# Compose agents should use ops/apply-msconnect-release.sh from the host;
# do not mount the Docker socket into application containers by default.
# MSCONNECT_UPGRADE_HOOK=/opt/msconnect2/ops/apply-msconnect-release.sh
